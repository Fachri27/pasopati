APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=pasopati_new
# DB_USERNAME=root
# DB_PASSWORD=

# Koneksi kedua: database PostGIS di belakang GeoServer (sumber data layer
# lokasi untuk pencarian lokasi event). Isi bila CRUD Event dipakai.
DB_CONNECTION_GEO=pgsql
# DB_HOST_GEO=127.0.0.1
# DB_PORT_GEO=5432
# DB_DATABASE_GEO=simontini
# DB_USERNAME_GEO=
# DB_PASSWORD_GEO=

# Layer lokasi yang dipakai pencarian (tabel PostGIS di belakang GeoServer).
# Contoh default: proteus.POLITICAL_LEVEL_6_dissolved dengan kolom NAME,
# latitude, longtitude, geom (PostGIS 4326).
GEOSERVER_LOCATION_TABLE=proteus.POLITICAL_LEVEL_6_dissolved
GEOSERVER_NAME_PROPERTY=NAME
GEOSERVER_SEARCH_PROPERTIES=NAME,NAME_EN_US
GEOSERVER_LATITUDE_COLUMN=latitude
GEOSERVER_LONGITUDE_COLUMN=longtitude
GEOSERVER_GEOMETRY_COLUMN=geom
GEOSERVER_GEOMETRY_SRID=4326
GEOSERVER_SEARCH_LIMIT=20

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# true = pakai test key Cloudflare yang selalu lolos (khusus pengembangan, saat
# hostname dev belum di-whitelist di dashboard Cloudflare). Biarkan kosong/false
# di server mana pun yang dipakai sungguhan.
TURNSTILE_TEST_KEYS=false

# Login Google untuk kolom komentar (Laravel Socialite). Buat OAuth client di
# Google Cloud Console, lalu daftarkan di sana:
#   Authorized JavaScript origins -> https://pasopati.id
#   Authorized redirect URIs      -> https://pasopati.id/comment/login/google/callback
# Tambahkan juga host pengembangan bila ingin login dari mesin sendiri.
#
# GOOGLE_REDIRECT_URI boleh DIKOSONGKAN: bila kosong, callback diturunkan dari
# host yang sedang dibuka, jadi selalu cocok dan tidak bisa tertinggal menunjuk
# host lain (penyebab lazim InvalidStateException). Isi hanya bila perlu
# dipatok, mis. saat aplikasi berada di belakang proxy dengan host berbeda.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://pasopati.id/comment/login/google/callback

# Token untuk autentikasi endpoint GET sindikasi yang CMS expose ke web lain
# (Authorization: Bearer atau ?token=). Wajib diisi bila endpoint dipakai.
DEFORESTORY_API_KEY=

# Webhook keluar: saat laporan di-publish, CMS POST ke URL web lain (boleh
# beberapa, dipisah koma) supaya langsung update tanpa polling. Kosongkan
# kalau belum dipakai. DEFORESTORY_WEBHOOK_SECRET dipakai menandatangani payload
# (header X-Deforestory-Signature = sha256 HMAC) agar penerima bisa verifikasi.
DEFORESTORY_WEBHOOK_URL=
DEFORESTORY_WEBHOOK_SECRET=

# Sync keluar ke simontini: saat laporan di-publish/unpublish, CMS POST ke
# endpoint simontini (Authorization: Bearer DEFORESTORY_SYNC_TOKEN). Kosongkan
# kalau simontini belum siap terima → sync di-skip diam-diam.
DEFORESTORY_SYNC_URL=https://simontini.id/api/deforestory/sync
DEFORESTORY_SYNC_TOKEN=

VITE_APP_NAME="${APP_NAME}"

# Video (CRUD Event): thumbnail otomatis dari video (screenshot frame).
# Path ffmpeg; isi "/usr/bin/ffmpeg" bila tidak ada di PATH.
FFMPEG_PATH=ffmpeg
# Detik video yang diambil sebagai thumbnail.
VIDEO_THUMBNAIL_SEEK=1
# Timeout proses ffmpeg (detik).
FFMPEG_TIMEOUT=30
